{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip install *)",
      "Bash(source .venv/bin/activate)",
      "Bash(aws bedrock *)",
      "Bash(aws bedrock-runtime *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls *)",
      "Bash(cat *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)"
    ]
  }
}
