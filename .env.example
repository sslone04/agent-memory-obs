# Copy to .env and fill in. .env is gitignored and blocked by the pre-commit hook.

# CockroachDB connection string. From the CockroachDB Cloud console:
#   Cluster -> Connect -> General connection string.
# Keep sslmode=verify-full. On first connect the console will also have you
# download the cluster CA to ~/.postgresql/root.crt.
DATABASE_URL=postgresql://<user>:<password>@<host>.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# --- optional ---

# AWS region for Bedrock. Defaults to us-east-1.
# AWS_REGION=us-east-1

# Model used by agent.py. Defaults to Claude Sonnet 4.5 via a cross-region
# inference profile. Override once your account has access to a newer model.
# AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Cheaper model used only for write-back fact extraction.
# AGENT_EXTRACTOR_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Port for the dashboard. Defaults to 8000.
# PORT=8000
